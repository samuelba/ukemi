# Updates for Ukemi, from https://github.com/samuelba/ukemi. Installed by the ukemi package; to
# stop them, set enabled=0 rather than deleting this file.
#
# The repository's metadata is signed and lists every package's checksum, so the packages
# themselves need no signature of their own (gpgcheck=0).
[ukemi]
name=Ukemi
baseurl=https://samuelba.dev/ukemi/rpm
enabled=1
gpgcheck=0
repo_gpgcheck=1
gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-ukemi
metadata_expire=6h
