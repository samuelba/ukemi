    "submenus": [
      {
        "id": "ukemi.duplicate",
        "label": "Duplicate"
      },
      {
        "id": "ukemi.rebase",
        "label": "Rebase"
      },
      {
        "id": "ukemi.viewMode",
        "label": "View"
      }
    ],
    "menus": {
      "webview/context": [
        {
          "command": "ukemi.commit.new",
          "group": "1_new@1",
          "when": "webviewId =~ /^ukemi\\.graph/ && webviewSection == 'commit'"
        },
        {
          "command": "ukemi.commit.newBefore",
          "group": "1_new@2",
          "when": "webviewId =~ /^ukemi\\.graph/ && webviewSection == 'commit' && !isImmutable"
        },
        {
          "command": "ukemi.commit.edit",
          "group": "1_new@3",
          "when": "webviewId =~ /^ukemi\\.graph/ && webviewSection == 'commit' && !isWorkingCopy && !isImmutable"
        },
        {
          "command": "ukemi.commit.makeEditable",
          "group": "1_new@4",
          "when": "webviewId =~ /^ukemi\\.graph/ && webviewSection == 'commit' && isImmutable"
        },
        {
          "command": "ukemi.commit.describe",
          "group": "2_describe@1",
          "when": "webviewId =~ /^ukemi\\.graph/ && webviewSection == 'commit' && !isImmutable"
        },
        {
          "command": "ukemi.commit.viewDiff",
          "group": "2_describe@2",
          "when": "webviewId =~ /^ukemi\\.graph/ && webviewSection == 'commit' && !isEmpty"
        },
        {
          "command": "ukemi.commit.squash",
          "group": "3_rewrite@1",
          "when": "webviewId =~ /^ukemi\\.graph/ && webviewSection == 'commit' && !isImmutable && !(isWorkingCopy && isEmpty)"
        },
        {
          "command": "ukemi.commit.split",
          "group": "3_rewrite@2",
          "when": "webviewId =~ /^ukemi\\.graph/ && webviewSection == 'commit' && !isImmutable && !isEmpty",
          "alt": "ukemi.commit.splitByFiles"
        },
        {
          "submenu": "ukemi.rebase",
          "group": "3_rewrite@3",
          "when": "webviewId =~ /^ukemi\\.graph/ && webviewSection == 'commit' && !isImmutable"
        },
        {
          "submenu": "ukemi.duplicate",
          "group": "3_rewrite@4",
          "when": "webviewId =~ /^ukemi\\.graph/ && webviewSection == 'commit'"
        },
        {
          "command": "ukemi.commit.revert",
          "group": "3_rewrite@5",
          "when": "webviewId =~ /^ukemi\\.graph/ && webviewSection == 'commit' && !isEmpty"
        },
        {
          "command": "ukemi.commit.abandon",
          "group": "3_rewrite@6",
          "when": "webviewId =~ /^ukemi\\.graph/ && webviewSection == 'commit' && !isImmutable",
          "alt": "ukemi.commit.abandonSubtree"
        },
        {
          "command": "ukemi.commit.setBookmark",
          "group": "4_share@1",
          "when": "webviewId =~ /^ukemi\\.graph/ && webviewSection == 'commit'"
        },
        {
          "command": "ukemi.commit.createRequest",
          "group": "4_share@2",
          "when": "webviewId =~ /^ukemi\\.graph/ && webviewSection == 'commit' && hasForge && !isImmutable && !hasRequest",
          "alt": "ukemi.commit.createRequestNamed"
        },
        {
          "command": "ukemi.commit.shipNow",
          "group": "4_share@3",
          "when": "webviewId =~ /^ukemi\\.graph/ && webviewSection == 'commit' && hasRemotes && !isImmutable"
        },
        {
          "command": "ukemi.commit.newWorkspace",
          "group": "4_share@4",
          "when": "webviewId =~ /^ukemi\\.graph/ && webviewSection == 'commit'"
        },
        {
          "command": "ukemi.commit.copyChangeId",
          "group": "9_copy@1",
          "when": "webviewId =~ /^ukemi\\.graph/ && webviewSection == 'commit'",
          "alt": "ukemi.commit.copyCommitId"
        },
        {
          "command": "ukemi.bookmark.push",
          "group": "1_bookmark@1",
          "when": "webviewId =~ /^ukemi\\.graph/ && webviewSection == 'bookmark' && !isRemoteOnly && !isSynced"
        },
        {
          "command": "ukemi.bookmark.createRequest",
          "group": "1_bookmark@2",
          "when": "webviewId =~ /^ukemi\\.graph/ && webviewSection == 'bookmark' && hasForge && !isRemoteOnly && !isTrunk"
        },
        {
          "command": "ukemi.bookmark.track",
          "group": "1_bookmark@3",
          "when": "webviewId =~ /^ukemi\\.graph/ && webviewSection == 'bookmark' && isRemoteOnly && !isTracked"
        },
        {
          "command": "ukemi.bookmark.delete",
          "group": "2_remove@1",
          "when": "webviewId =~ /^ukemi\\.graph/ && webviewSection == 'bookmark' && !isRemoteOnly"
        },
        {
          "command": "ukemi.bookmark.forget",
          "group": "2_remove@2",
          "when": "webviewId =~ /^ukemi\\.graph/ && webviewSection == 'bookmark'"
        },
        {
          "command": "ukemi.bookmark.newWorkspace",
          "group": "3_workspace@1",
          "when": "webviewId =~ /^ukemi\\.graph/ && webviewSection == 'bookmark'"
        },
        {
          "command": "ukemi.request.open",
          "group": "1_request@1",
          "when": "webviewId =~ /^ukemi\\.graph/ && webviewSection == 'request'"
        },
        {
          "command": "ukemi.request.pushUpdates",
          "group": "1_request@2",
          "when": "webviewId =~ /^ukemi\\.graph/ && webviewSection == 'request' && isOpen"
        },
        {
          "command": "ukemi.request.merge",
          "group": "1_request@3",
          "when": "webviewId =~ /^ukemi\\.graph/ && webviewSection == 'request' && isOpen"
        },
        {
          "command": "ukemi.request.cleanup",
          "group": "1_request@4",
          "when": "webviewId =~ /^ukemi\\.graph/ && webviewSection == 'request' && isMerged"
        },
        {
          "command": "ukemi.request.copyUrl",
          "group": "9_copy@1",
          "when": "webviewId =~ /^ukemi\\.graph/ && webviewSection == 'request'"
        },
        {
          "command": "ukemi.workspace.openHere",
          "group": "1_workspace@1",
          "when": "webviewId =~ /^ukemi\\.graph/ && webviewSection == 'workspace'"
        },
        {
          "command": "ukemi.workspace.open",
          "group": "1_workspace@2",
          "when": "webviewId =~ /^ukemi\\.graph/ && webviewSection == 'workspace'"
        },
        {
          "command": "ukemi.workspace.openTerminal",
          "group": "1_workspace@3",
          "when": "webviewId =~ /^ukemi\\.graph/ && webviewSection == 'workspace'"
        },
        {
          "command": "ukemi.workspace.snapshot",
          "group": "1_workspace@4",
          "when": "webviewId =~ /^ukemi\\.graph/ && webviewSection == 'workspace'"
        },
        {
          "command": "ukemi.workspace.reveal",
          "group": "1_workspace@5",
          "when": "webviewId =~ /^ukemi\\.graph/ && webviewSection == 'workspace'"
        },
        {
          "command": "ukemi.workspace.newChange",
          "group": "1_workspace@6",
          "when": "webviewId =~ /^ukemi\\.graph/ && webviewSection == 'workspace'"
        },
        {
          "command": "ukemi.workspace.copyPath",
          "group": "9_copy@1",
          "when": "webviewId =~ /^ukemi\\.graph/ && webviewSection == 'workspace'"
        },
        {
          "command": "ukemi.workspace.delete",
          "group": "2_remove@1",
          "when": "webviewId =~ /^ukemi\\.graph/ && webviewSection == 'workspace' && !isDefault"
        },
        {
          "command": "ukemi.file.openDiff",
          "group": "1_open@1",
          "when": "webviewId =~ /^ukemi\\.graph/ && webviewSection == 'file'"
        },
        {
          "command": "ukemi.file.open",
          "group": "1_open@2",
          "when": "webviewId =~ /^ukemi\\.graph/ && webviewSection == 'file'"
        },
        {
          "command": "ukemi.file.splitBelow",
          "group": "2_split@1",
          "when": "webviewId =~ /^ukemi\\.graph/ && webviewSection == 'file' && canSplit"
        },
        {
          "command": "ukemi.file.splitAbove",
          "group": "2_split@2",
          "when": "webviewId =~ /^ukemi\\.graph/ && webviewSection == 'file' && canSplit"
        },
        {
          "command": "ukemi.file.discard",
          "group": "3_discard@1",
          "when": "webviewId =~ /^ukemi\\.graph/ && webviewSection == 'file' && !isImmutable"
        },
        {
          "command": "ukemi.file.copyPath",
          "group": "9_copy@1",
          "when": "webviewId =~ /^ukemi\\.graph/ && webviewSection == 'file'"
        }
      ],
