{
  "name": "ukemi",
  "displayName": "Ukemi: Jujutsu (jj) GUI",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "vscode": "^1.90.0"
  },
  "main": "./dist/extension.js",
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "package:build": "node esbuild.mjs --production",
    "typecheck": "tsc -p .",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "icons": "node scripts/render-icons.mjs",
    "package": "vsce package --no-dependencies",
    "install:cursor": "npm run package && cursor --install-extension ukemi-$npm_package_version.vsix --force",
    "vscode:prepublish": "npm run package:build",
    "test:e2e": "npm run build && node test/e2e/runE2e.mjs"
  },
  "dependencies": {
    "@vscode/codicons": "^0.0.46-24",
    "diff": "^8.0.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^20.19.43",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/vscode": "^1.90.0",
    "@vitest/coverage-v8": "^3.2.7",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^3.2.7"
  },
  "publisher": "ukemi",
  "description": "Jujutsu (jj) version control GUI: change graph, drag and drop rebase, hunk split, undo, GitHub PRs and GitLab MRs.",
  "license": "MIT",
  "icon": "resources/icon.png",
  "galleryBanner": {
    "color": "#F4EFE6",
    "theme": "light"
  },
  "categories": [
    "SCM Providers",
    "Visualization"
  ],
  "keywords": [
    "jj",
    "jujutsu",
    "jj-vcs",
    "vcs",
    "scm",
    "git",
    "graph",
    "stacked",
    "gitlab",
    "github"
  ],
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "ukemi",
          "title": "Ukemi (jj)",
          "icon": "resources/activity.svg"
        }
      ]
    },
    "views": {
      "ukemi": [
        {
          "type": "webview",
          "id": "ukemi.graph",
          "name": "Graph",
          "icon": "resources/activity.svg",
          "contextualTitle": "Ukemi"
        },
        {
          "id": "ukemi.workspaces",
          "name": "Workspaces"
        },
        {
          "id": "ukemi.evolution",
          "name": "Evolution",
          "icon": "$(versions)"
        }
      ]
    },
