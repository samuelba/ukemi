    "configuration": {
      "title": "Ukemi",
      "properties": {
        "ukemi.jjPath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Path to the jj binary. Empty means search PATH and common install folders."
        },
        "ukemi.addJjToTerminalPath": {
          "type": "boolean",
          "default": true,
          "description": "Add the jj binary that Ukemi downloaded to PATH in integrated terminals."
        },
        "ukemi.showSourceControl": {
          "type": "string",
          "enum": [
            "auto",
            "always",
            "never"
          ],
          "default": "auto",
          "enumDescriptions": [
            "Show for jj repositories that the Git extension does not show.",
            "Always show.",
            "Never show."
          ],
          "description": "Show jj working copy changes in the Source Control view."
        },
        "ukemi.showInPanel": {
          "type": "boolean",
          "default": false,
          "description": "Open the change graph in an editor tab instead of the side bar."
        },
        "ukemi.showEditorTitleDiff": {
          "type": "boolean",
          "default": false,
          "description": "Show an \"Open Changes (jj)\" button in the editor title."
        },
        "ukemi.followActiveEditor": {
          "type": "boolean",
          "default": true,
          "description": "Switch to the repository of the active editor."
        },
        "ukemi.repoScanDepth": {
          "type": "integer",
          "default": 4,
          "minimum": 0,
          "maximum": 10,
          "description": "How many folder levels to search for repositories inside each workspace folder."
        },
        "ukemi.repoScanExclude": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "node_modules",
            "build",
            "install",
            "log",
            "dist",
            "out",
            "target",
            "venv",
            ".venv",
            "__pycache__"
          ],
          "description": "Folder names to skip during the repository search."
        },
        "ukemi.defaultFilter": {
          "type": "string",
          "enum": [
            "recent",
            "mine",
            "myHistory",
            "stack",
            "working"
          ],
          "default": "recent",
          "enumDescriptions": [
            "Your open changes, bookmarks and tags in the time range.",
            "All your open changes.",
            "Your open changes, and your history in the time range.",
            "The changes connected to the working copy.",
            "The working copy and its last 5 first parents."
          ],
          "description": "Filter that the change graph shows first."
        },
        "ukemi.historyDepth": {
          "type": "string",
          "enum": [
            "7d",
            "14d",
            "30d",
            "1y",
            "all"
          ],
          "default": "7d",
          "description": "Default history depth of the change graph."
        },
        "ukemi.changeIdLength": {
          "type": "integer",
          "default": 4,
          "minimum": 1,
          "maximum": 12,
          "description": "Minimum number of change ID characters to show."
        },
        "ukemi.showFullPaths": {
          "type": "boolean",
          "default": false,
          "description": "Show full file paths in the change graph."
        },
        "ukemi.workspaces.snapshotOnRefresh": {
          "type": "boolean",
          "default": false,
          "description": "On each refresh, snapshot every other workspace so its file changes show up. Each snapshot is a jj operation and can race with jj running in that workspace."
        },
        "ukemi.changedFilesView": {
          "type": "string",
          "enum": [
            "list",
            "tree"
          ],
          "default": "list",
          "enumDescriptions": [
            "One row per file.",
            "Files grouped by folder."
          ],
          "description": "How changed files appear under a change in the graph."
        },
        "ukemi.github.hosts": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Additional GitHub Enterprise hosts, for example github.example.com."
        },
        "ukemi.gitlab.hosts": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Additional self-hosted GitLab hosts, for example git.example.com."
        }
      }
    },
    "configurationDefaults": {
      "files.exclude": {
        "**/.jj": true
      }
    }
  }
}
