        },
        {
          "command": "ukemi.evolution.open",
          "group": "1_open@1",
          "when": "view == ukemi.evolution && viewItem =~ /openable/"
        },
        {
          "command": "ukemi.evolution.compare",
          "group": "inline@1",
          "when": "view == ukemi.evolution && viewItem =~ /comparable/"
        },
        {
          "command": "ukemi.evolution.restore",
          "group": "inline@2",
          "when": "view == ukemi.evolution && viewItem =~ /restorable/"
        }
